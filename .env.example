# Beispielkonfiguration – auf dem Server legt scripts/hostinger/update.sh daraus beim ersten Deploy die .env an.
# Echte Zugangsdaten nur in der .env auf dem Server bzw. lokal eintragen, nie committen.

APP_NAME="My Golf Course"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# Für den Test: SQLite (Datei im App-Ordner, außerhalb von public_html). Später MySQL aus dem hPanel:
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Demoplatz bei jedem Deploy neu anlegen (database/seeders/DemoCourseSeeder.php); in Produktion false
DEMO_DATA=true

# Admin-Zugang (folgt mit dem Admin-Bereich): nur diese Adressen dürfen Admin sein
ADMIN_EMAILS=
ADMIN_IDLE_TIMEOUT=30

# Medien (Anbieter noch offen, docs/DECISIONS.md D-007)
MEDIA_PROVIDER=
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_CDN_URL=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=

# Impressum / Datenschutz (config/legal.php)
LEGAL_OPERATOR=
LEGAL_STREET=
LEGAL_CITY=
LEGAL_EMAIL=
LEGAL_DRAFT=true
